# ---------------------------------------------------------------
# PRIVACY-CRITICAL — never commit these.
# The Dmills voiceprint is a private, undistributed personal build.
# Training audio and model weights stay on this machine, always.
# ---------------------------------------------------------------
# downloaded audio, transcripts, sqlite db
data/
# TTS model weights, reference clips, voiceprint datasets
voices/
# resume, goals, fandom — personal
profile/
*.wav
*.mp3
*.m4a
*.flac
*.onnx
*.ckpt
*.pt
*.pth
.env
.env.*
!.env.example
# Already covered by .env.* above, but spelled out because this one is the
# decryption key for every encrypted value in .env. Committing it would make
# the encryption worthless — it is the single worst file in the repo to leak.
.env.keys
# Leftover from before Google OAuth moved into .env as plain env vars — kept
# ignored in case an old copy is still lying around locally.
google_credentials.json
google_token.json

