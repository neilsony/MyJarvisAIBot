{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(./.env)",
      "Read(**/.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(less .env)",
      "Bash(more .env)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(grep .env)",
      "Bash(vim .env)",
      "Bash(nano .env)",
      "Bash(open .env)",
      "Bash(pbcopy < .env)"
    ]
  }
}
