# Copy to .env and fill in. .env is gitignored — never commit real keys.
# cp .env.example .env

# --- Phase 0: corpus pipeline ---
# HuggingFace token, needed by pyannote for diarization.
# Get one at https://huggingface.co/settings/tokens (read access is enough),
# then accept the gated model terms — see SETUP.md step 3.
HF_TOKEN=

# --- Phase 1: the brain ---
# https://openrouter.ai/keys — pay-as-you-go, no subscription credit involved.
OPENROUTER_API_KEY=

# Which model the agent runs on, via OpenRouter. Flip this to A/B the register.
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# --- Phase 2: speech-to-text ---
# https://console.deepgram.com — not needed until the voice loop.
DEEPGRAM_API_KEY=

# --- Phase 4: Google Calendar ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID >
# Desktop app. Open the downloaded JSON and copy these two fields in — no
# client-secrets file is ever read from disk, only these two values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# download API token as JSON from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs > Desktop app > Download JSON
# then copy the entire JSON into this variable, as a single line. T
GOOGLE_TOKEN_JSON=

# --- Spotify playback (optional) ---
# developer.spotify.com/dashboard > Create app > tick "Web API", and add the
# redirect URI http://127.0.0.1:8888/callback exactly. Copy the app's Client ID
# and Client Secret here. Playback control needs Spotify Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Written for you by: python -m brain.authorize_spotify. Don't paste by hand.
SPOTIFY_TOKEN_JSON=

# Optional, and ignored once the bot's own player is set up (SETUP.md step 14.3).
# Without that player, the bot uses whatever device has Spotify open; set this
# (part of the device's name, e.g. Web Player) to choose between several.
SPOTIFY_DEVICE_NAME=
