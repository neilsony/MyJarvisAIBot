# Copy to .env and fill in. .env is gitignored — never commit real keys.
# cp .env.example .env

# --- Phase 0: corpus pipeline ---
# HuggingFace token, needed by pyannote for diarization.
# Get one at https://huggingface.co/settings/tokens (read access is enough),
# then accept the gated model terms — see SETUP.md step 3.
HF_TOKEN=

# --- Phase 1: the brain ---
# https://openrouter.ai/keys — pay-as-you-go, no subscription credit involved.
OPENROUTER_API_KEY=

# Which model the agent runs on, via OpenRouter. Flip this to A/B the register.
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# --- Phase 2: speech-to-text ---
# https://console.deepgram.com — not needed until the voice loop.
DEEPGRAM_API_KEY=

# --- Phase 4: Google Calendar ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID >
# Desktop app. Open the downloaded JSON and copy these two fields in — no
# client-secrets file is ever read from disk, only these two values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# download API token as JSON from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs > Desktop app > Download JSON
# then copy the entire JSON into this variable, as a single line. T
GOOGLE_TOKEN_JSON=
